extends ../../layouts/default.pug
include ../../mixins/pagination.pug

block main
  if(role.permissions.includes('music_view'))
    h1(class="mb-4") #{pageTitle}
    .card.mb-3
      .card-header Danh sách
      .card-body
        .row.mb-3
          .col-md-8
            form(action=`/${prefixAdmin}/songs` method="GET" class="form-inline")
              input.form-control.mr-2(
                type="text"
                name="keyword"
                value=keyword || ""
                placeholder="Tìm theo tên bài hát..."
              )
              button.btn.btn-primary(type="submit") Tìm
              if keyword
                a.btn.btn-link(href=`/${prefixAdmin}/songs`) Xóa lọc
          .col-md-4.text-right
            if(role.permissions.includes('music_create'))
              a(href=`/${prefixAdmin}/songs/create` class="btn btn-outline-success") + Thêm mới

        table(class="table table-hover table-sm")
          thead
            tr
              th STT
              th Hình ảnh
              th Tiêu đề
              th Trạng thái
              th Hành động
          tbody
            each item, index in songs
              tr
                td #{(pagination.page - 1) * pagination.limit + index + 1}
                td
                  img(
                    src=item.avatar
                    alt=item.title
                    width="80px"
                    height="auto"
                  )
                td #{item.title}
                td(td-status)
                  if (item.status === "active")
                    a(
                      href="javascript:;"
                      class="badge badge-success"
                      button-status
                      data-status=item.status
                      data-id=item.id
                      data-path=`/${prefixAdmin}/songs/changeStatus`
                    ) Hoạt động
                  else
                    a(
                      href="javascript:;"
                      class="badge badge-danger"
                      button-status
                      data-status=item.status
                      data-id=item.id
                      data-path=`/${prefixAdmin}/songs/changeStatus`
                    ) Dừng hoạt động
                td
                  if(role.permissions.includes('music_view'))
                    a(
                      class="btn btn-secondary btn-sm"
                      href=`/${prefixAdmin}/songs/detail/${item.id}`
                    ) Chi tiết
                  if(role.permissions.includes('music_edit'))
                    a(
                      class="btn btn-warning btn-sm ml-1"
                      href=`/${prefixAdmin}/songs/edit/${item.id}`
                    ) Sửa
                  if(role.permissions.includes('music_delete'))
                    button(
                      class="btn btn-danger btn-sm ml-1"
                      button-delete
                      data-id=item.id
                      data-path=`/${prefixAdmin}/songs/delete`
                      data-method="PATCH"
                    ) Xóa
            else
              tr
                td(colspan="5" class="text-center text-muted") Không có bài hát

        - const base = keyword ? `/${prefixAdmin}/songs?keyword=${encodeURIComponent(keyword)}` : `/${prefixAdmin}/songs`
        +pagination(pagination, base)
  else
    h1 Bạn không có quyền xem danh sách bài hát
