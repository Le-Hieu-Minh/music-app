mixin pagination(pagination, baseUrl)
  if pagination && pagination.totalPage > 1
    nav.mt-4(aria-label="Phân trang")
      ul.pagination.justify-content-center
        - const page = pagination.page
        - const totalPage = pagination.totalPage
        - const sep = baseUrl.includes("?") ? "&" : "?"
        li.page-item(class=page <= 1 ? "disabled" : "")
          a.page-link(href=page <= 1 ? "#" : `${baseUrl}${sep}page=${page - 1}`) Trước
        - for (let i = 1; i <= totalPage; i++)
          if i === 1 || i === totalPage || (i >= page - 2 && i <= page + 2)
            li.page-item(class=i === page ? "active" : "")
              a.page-link(href=`${baseUrl}${sep}page=${i}`) #{i}
          else if i === page - 3 || i === page + 3
            li.page-item.disabled
              span.page-link ...
        li.page-item(class=page >= totalPage ? "disabled" : "")
          a.page-link(href=page >= totalPage ? "#" : `${baseUrl}${sep}page=${page + 1}`) Sau
