header.header
  .container
    .row.align-items-center
      .col-lg-2.col-md-3.col-12.mb-2.mb-md-0
        .inner-logo
          a(href="/")
            img(
              src=(settingGeneral && settingGeneral.logo) ? settingGeneral.logo : "/image/spotify_logo.jpg"
              alt=(settingGeneral && settingGeneral.websiteName) ? settingGeneral.websiteName : "Music App"
            )

      .col-lg-4.col-md-9.col-12.mb-2.mb-lg-0
        .box-search
          form(action="/search/result" method="GET")
            div(class="form-group d-flex mb-0")
              input(
                type="text"
                placeholder="Tìm bài hát..."
                class="form-control"
                name="keyword"
                value=keyword || ""
                autocomplete="off"
              )
              button(type="submit" class="btn btn-primary") Tìm
          .inner-suggest
            .inner-list

      .col-lg-6.col-12
        .inner-menu
          ul
            li
              a(href="/") Trang chủ
            li
              a(href="/topics") Chủ đề
            li
              a(href="/singers") Ca sĩ
            li
              a(href="/charts") BXH
            li
              a(href="/favorite-songs") Yêu thích
            li
              a(href="/playlists") Playlist
            if custummer
              li
                a(href="/users/info") #{custummer.fullName}
              li
                a(href="/users/logout") Đăng xuất
            else
              li
                a(href="/users/login") Đăng nhập
              li
                a(href="/users/register") Đăng ký
