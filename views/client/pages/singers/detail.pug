extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row.mb-4.align-items-center
      .col-auto
        .singer-avatar
          img(
            src=singer.avatar || "/image/spotify_logo.jpg"
            alt=singer.fullName
          )
      .col
        +box-head(pageTitle)
        p.text-muted.mb-0 Danh sách bài hát của ca sĩ

    .row
      each song in songs
        .col-12.col-md-6.mb-3
          .song-item
            .inner-image
              a(href=`/songs/detail/${song.slug}`)
                img(src=song.avatar || "/image/spotify_logo.jpg")
            .inner-content
              .inner-title1
                a(href=`/songs/detail/${song.slug}`) #{song.title}
              .inner-like
                i(class="fa-solid fa-thumbs-up")
                | #{song.like ? song.like.length : 0}
              .inner-time
                i(class="fa-solid fa-headphones")
                | #{song.listen || 0} lượt nghe
      else
        .col-12
          .empty-state Chưa có bài hát nào.
