extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head(pageTitle)

    .row
      each topic in topics
        .col-12.col-md-6.col-lg-4.mb-3
          .card.topic-card
            img(
              src=topic.avatar || "/image/spotify_logo.jpg"
              alt=topic.title
            )
            .card-body
              h5.card-title #{topic.title}
              p.card-text !{topic.description || ""}
              a(href=`/songs/${topic.slug}` class="btn btn-primary btn-sm") Xem chi tiết
      else
        .col-12
          .empty-state Chưa có chủ đề nào.
