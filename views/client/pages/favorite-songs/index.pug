extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head(pageTitle)

    .row
      each song in favoriteSongs
        .col-12.col-md-6.mb-3
          .song-item
            .inner-image
              a(href=`/songs/detail/${song.infoSong.slug}`)
                img(src=song.infoSong.avatar || "/image/spotify_logo.jpg")
            .inner-content
              .inner-title1
                a(href=`/songs/detail/${song.infoSong.slug}`) #{song.infoSong.title}
              .inner-singer
                i(class="fa-solid fa-microphone-lines")
                | #{song.infoSinger ? song.infoSinger.fullName : "Đang cập nhật"}
              .inner-heart.active(button-favorite=song.songId)
                i(class="fa-regular fa-heart")
                | Yêu thích
      else
        .col-12
          .empty-state Bạn chưa có bài hát yêu thích nào.
