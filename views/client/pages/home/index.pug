extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-5
    .section-topics.mb-5
      +box-head("Thể loại âm nhạc")
      .row
        each topic in topics
          .col-6.col-md-3.col-lg-2.mb-3
            a(href=`/songs/${topic.slug}` class="text-decoration-none")
              .card.inner-topic-card.text-center.border-0.shadow-sm
                img.card-img-top(
                  src=topic.avatar || "/image/spotify_logo.jpg"
                  alt=topic.title
                )
                .card-body.p-2
                  h6.card-title.text-dark.mb-0 #{topic.title}
      .text-right.mt-2
        a(href="/topics") Xem tất cả chủ đề →

    .section-singers.mb-5
      +box-head("Nghệ sĩ phổ biến")
      .row
        each singer in singers
          .col-6.col-md-4.col-lg-2.mb-4
            .text-center
              a(href=`/singers/${singer.slug}` class="singer-avatar d-inline-block")
                img(
                  src=singer.avatar || "/image/spotify_logo.jpg"
                  alt=singer.fullName
                )
              a(href=`/singers/${singer.slug}` class="text-decoration-none")
                h6.text-dark.mt-2.mb-0 #{singer.fullName}
      .text-right.mt-2
        a(href="/singers") Xem tất cả ca sĩ →

    .section-songs.mb-5
      +box-head("Bài hát nổi bật")
      .row
        each song in songs
          .col-12.col-md-6.col-lg-4.mb-3
            .song-item
              .inner-image
                a(href=`/songs/detail/${song.slug}`)
                  img(src=song.avatar || "/image/spotify_logo.jpg" alt=song.title)
              .inner-content
                .inner-title1
                  a(href=`/songs/detail/${song.slug}`) #{song.title}
                .inner-singer
                  i.fa-solid.fa-microphone-lines
                  if song.infoSinger
                    a(href=`/singers/${song.infoSinger.slug}` class="text-muted") #{song.infoSinger.fullName}
                  else
                    | Đang cập nhật
                .inner-like
                  i.fa-solid.fa-thumbs-up
                  | #{song.like ? song.like.length : 0}
                .inner-time
                  i.fa-solid.fa-headphones
                  | #{song.listen || 0} lượt nghe

    .section-new-songs.mb-5
      +box-head("Bài hát mới")
      .row
        each song in newSongs
          .col-12.col-md-6.col-lg-4.mb-3
            .song-item
              .inner-image
                a(href=`/songs/detail/${song.slug}`)
                  img(src=song.avatar || "/image/spotify_logo.jpg" alt=song.title)
              .inner-content
                .inner-title1
                  a(href=`/songs/detail/${song.slug}`) #{song.title}
                .inner-singer
                  i.fa-solid.fa-microphone-lines
                  | #{song.infoSinger ? song.infoSinger.fullName : "Đang cập nhật"}
                .inner-like
                  i.fa-solid.fa-thumbs-up
                  | #{song.like ? song.like.length : 0}
                .inner-time
                  i.fa-solid.fa-headphones
                  | #{song.listen || 0} lượt nghe
