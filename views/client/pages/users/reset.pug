extends ../../layouts/auth.pug

block main
  .container
    .row.justify-content-center
      .col-md-7.col-lg-5
        h1(class="text-center") Đặt lại mật khẩu
        if messages && messages.error
          .alert.alert-danger #{messages.error}
        form(action="/users/fogot-password/reset-password" method="POST")
          .form-group
            label(for="password") Mật khẩu mới
            input#password.form-control(type="password" name="password" required)
          .form-group
            label(for="confirmPassword") Nhập lại mật khẩu
            input#confirmPassword.form-control(type="password" name="confirmPassword" required)
          .form-group.mb-2
            button.btn.btn-primary.btn-block(type="submit") Xác nhận
