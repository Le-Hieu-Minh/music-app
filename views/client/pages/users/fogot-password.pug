extends ../../layouts/auth.pug

block main
  .container
    .row.justify-content-center
      .col-md-7.col-lg-5
        h1(class="text-center") Quên mật khẩu
        if messages && messages.error
          .alert.alert-danger #{messages.error}
        form(action="/users/fogot-password" method="POST")
          .form-group
            label(for="email") Email
            input#email.form-control(type="email" name="email" required)
          .form-group.mb-2
            button.btn.btn-primary.btn-block(type="submit") Gửi mã OTP
        .text-center.mt-3
          a(href="/users/login") Quay lại đăng nhập
