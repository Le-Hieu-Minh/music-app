extends ../../layouts/auth.pug

block main
  .container
    .row.justify-content-center
      .col-md-7.col-lg-5
        h1(class="text-center") Đăng ký tài khoản
        if messages && messages.error
          .alert.alert-danger #{messages.error}
        form(action="/users/register" method="POST")
          .form-group
            label(for="fullName") Họ và tên
            input#fullName.form-control(type="text" name="fullName" required)
          .form-group
            label(for="email") Email
            input#email.form-control(type="email" name="email" required)
          .form-group
            label(for="password") Mật khẩu
            input#password.form-control(type="password" name="password" required)
          .form-group.mb-2
            button.btn.btn-primary.btn-block(type="submit") Đăng ký
        .text-center.mt-3
          a(href="/users/login") Đã có tài khoản? Đăng nhập
