extends ../../layouts/auth.pug

block main
  .container
    .row.justify-content-center
      .col-md-7.col-lg-5
        h1(class="text-center") Nhập mã OTP
        if messages && messages.error
          .alert.alert-danger #{messages.error}
        form(action="/users/fogot-password/otp" method="POST")
          .form-group
            label(for="email") Email
            input#email.form-control(type="email" name="email" value=email required)
          .form-group
            label(for="otp") Mã OTP
            input#otp.form-control(type="text" name="otp" required)
          .form-group.mb-2
            button.btn.btn-primary.btn-block(type="submit") Xác nhận
