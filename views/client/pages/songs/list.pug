extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/pagination.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head(pageTitle)

    .row
      each song in songs
        .col-12.col-md-6.mb-3
          .song-item
            .inner-image
              a(href=`/songs/detail/${song.slug}`)
                img(src=song.avatar || "/image/spotify_logo.jpg" alt=song.title)
            .inner-content
              .inner-title1
                a(href=`/songs/detail/${song.slug}`) #{song.title}
              .inner-singer
                i(class="fa-solid fa-microphone-lines")
                | #{song.infoSinger ? song.infoSinger.fullName : "Đang cập nhật"}
              .inner-like
                i(class="fa-solid fa-thumbs-up")
                | #{song.like ? song.like.length : 0}
              .inner-time
                i(class="fa-solid fa-headphones")
                | #{song.listen || 0}
      else
        .col-12
          .empty-state Chưa có bài hát trong chủ đề này.

    if pagination && baseUrl
      +pagination(pagination, baseUrl)
